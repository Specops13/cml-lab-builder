# Copy to .env and fill in. .env is read by run.sh / run.ps1. Leave CML_PASSWORD empty
# to enter it in the web Settings page (memory only) or store it with: run.sh save-password
CML_URL=https://cml.your-tailnet.ts.net
CML_USERNAME=admin
CML_PASSWORD=
CML_VERIFY_SSL=true
# Console server FQDN (port 22 proxy) for live checks: SSH to the CML console server.
# A proxy here must be TCP passthrough (nginx stream / HAProxy mode tcp), not HTTP.
CML_CONSOLE_HOST=
CML_CONSOLE_PORT=22
CMLLAB_PLATFORM=iol
CMLLAB_NODE_LIMIT=20
# auto = live console, fall back to config (HTTPS API) | live | config
CMLLAB_GRADING_MODE=auto
